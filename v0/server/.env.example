# Copy to .env (same folder). Leave NVIDIA_API_KEY empty to run in mock mode.
NVIDIA_API_KEY=
# LLM_PROVIDER=openai            # openai (any OpenAI-compatible API) | mock
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b   (default since 2026-11-11; never called for real yet)
#   The old default meta/llama-3.2-90b-vision-instruct is listed by NVIDIA as ending 2026-11-16.
# Other providers: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...
# TTS_ENGINE=auto                # auto | piper | espeak | none
# STT_ENGINE=auto                # auto | none
# DEVICE_TOKEN=                  # optional shared secret; set the same value in firmware secrets.h
# PORT=8000
# ---- v1 work API
# LLM_PROVIDER=nim               # nim | openai | mock. nim uses NVIDIA_API_KEY and defaults to nvidia/nemotron-3.5-super-vl-120b-a12b
# GLASSES_DB=data/glasses.db     # SQLite file for docs + personal memory
# SEED_DEMO=1                    # load sample_workspace/ as workspace "demo" on start
# RETRIEVER=bm25                 # bm25 | embed (needs sentence-transformers; EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2)
# RETRIEVAL_MIN_COVERAGE=0.5     # share of the question's rare words that must be in a passage, else "Not in your docs"
# CONTEXT_TTL_HOURS=8            # how long a /context label tags later questions
# CORS_ORIGINS=*                 # companion web app origin(s), comma-separated
# MAX_UPLOAD_MB=20
